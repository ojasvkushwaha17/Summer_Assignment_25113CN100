#include<stdio.h>
#include<math.h>
int main()
{
    int i=0, rem, binarynum, decimal=0;
    printf("enter a binary number: ");
    scanf("%d", &binarynum);
    
    while(binarynum>0)
    {
        rem=binarynum%10;
        decimal=decimal+rem*pow(2, i);
        binarynum=binarynum/10;
        i++;
    }
    printf("decimal= %d", decimal);
    printf("\n");
    return 0;
}
