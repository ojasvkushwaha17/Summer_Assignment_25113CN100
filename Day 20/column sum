#include <stdio.h>
int main() 
{
    int i, j, row, column, sum;
    printf("Enter rows and columns: \n");
    scanf("%d%d", &row, &column);
    int mat[row][column];
    printf("Enter matrix elements:\n");
    for(i=0; i<row; i++)
    {
        for(j=0; j<column; j++)
        {
            scanf("%d", &mat[i][j]);
        }
    }
    printf("Column-wise Sum:\n");
    for(j=0; j<column; j++) 
    {
        sum=0;
        for(i=0; i<row; i++) 
        {
            sum=sum+mat[i][j];
        }
        printf("sum of column %d: %d\n", j+1, sum);
    }
    return 0;
}
