#include <stdio.h>
int main()
{
    int n, i, j, array[100];
    printf("Enter number of elements in array: ");
    scanf("%d", &n);
    printf("Enter %d elements:\n", n);
    for(i=0; i<n; i++)
    {
        scanf("%d", &array[i]);
    }
    printf("duplicate elements are: ");
    for(i=0; i<n; i++)
    {
        for(j=i+1; j<n; j++)
        if(array[i]==array[j])
        {
            printf("%d, ", array[i]);
            break;
        }
    }
    return 0;
}
