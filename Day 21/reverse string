#include <stdio.h>
int main()
{
    char str[100];
    int i, length = 0;
    printf("Enter a string: ");
    fgets(str, sizeof(str), stdin);
    while (str[length] != '\0')
    {
        length++;
    }
    printf("reverse string: \n");
    for(i=length-2; i>=0; i--)
    {
        printf("%c", str[i]);
    }
    return 0;
}
