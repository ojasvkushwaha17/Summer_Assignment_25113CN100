#include<stdio.h>
#include<math.h>
void Armstrong(int num)
{
    int c=0, rem, temp, sum=0;
    int num1=num;
    while(num>0)
    {
        num=num/10;
        c++;
    }
    int num2=num;
    while(num>0)
    {
        rem=num%10;
        sum=sum+pow(rem, c);
        num=num/10;
    }
    if(sum==num2)
    {
        printf("%d is a armstrong number.", num1);
    }
    else
    {
        printf("%d is not a armstrong number.", num1);
    }
}
int main()
{
    int num;
    printf("enter a number: ");
    scanf("%d", &num);
    Armstrong(num);
    return 0;
}
