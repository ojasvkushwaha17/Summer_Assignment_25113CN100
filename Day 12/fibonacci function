#include<stdio.h>
void Fibonacci(int end)
{
    int i, num1=0, num2=1, temp;
    for(i=3; i<=end; i++)
    {
        temp=num1+num2;
        printf("%d, ", temp);
        num1=num2;
        num2=temp;
    }
}
int main()
{
    int num;
     printf("Enter the number till which you want to print the Fibonacci series: ");
    scanf("%d",&num);
    Fibonacci(num);
    return 0;
}
