#include <stdio.h>
int main()
{
    int i, n, item, found, arr[100], pos, mid, beg, end;
    printf("Enter the number of elements: ");
    scanf("%d", &n);

    printf("Enter the sorted elements:\n");
    for(i=0; i<n; i++) 
    {
        scanf("%d", &arr[i]);
    }
    printf("enter element to be searched: ");
    scanf("%d", &item);
    beg=0;
    end=n-1;
    while(beg<=end)
    {
        mid=(beg+end)/2;
        if(arr[mid]==item)
        {
            printf("element found at position: %d", mid);
            found=1;
            break;
        }
        else if(arr[mid]<item)
        {
            beg=mid+1;
        }
        else
        {
            end=mid-1;
        }
    }
    printf("%d does not exist in the array.", item);
    return 0;
}
