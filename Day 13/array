#include<stdio.h>
int main()
{
    int i, n;
    printf("enter size of array: ");
    scanf("%d", &n);
    int array[n];
    printf("Enter elements of array : \n");
    for(i=0; i<n; i++)
    {
        scanf("%d",&array[i]);
    }
    printf("entered Array is: \n");
    for(i=0; i<n; i++)
    {
        printf("%d\n", array[i]);
    }
    return 0;
}
