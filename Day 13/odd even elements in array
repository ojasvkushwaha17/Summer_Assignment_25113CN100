    for(i=0; i<n; i++)
    {
        scanf("%d", &a[i]);
    }
    int evencount = 0;
    int oddcount = 0;
    for(i=0; i<n; i++)
    {
        if(a[i]%2 == 0)
        {
            evencount++;
        }
        else
        {
            oddcount++;
        }
    }
    printf("number of even element = %d\n", evencount);
    printf("number of odd element = %d\n", oddcount);
    return 0;
}
