#include<stdio.h>
int main()
{
    int i, n;
    float sum=0, average;
    printf("enter size of array: ");
    scanf("%d", &n);
    int array[n];
    printf("Enter elements of array : \n");
    for(i=0; i<n; i++)
    {
        scanf("%d",&array[i]);
    }
    for(i=0; i<n; i++)
    {
        sum=sum+array[i];
        average=sum/n;
    }
    printf("sum of arrray is= %f\n", sum);
    printf("average of array is= %f", average);
    return 0;
}
