#include<stdio.h>
int main()
{
    int i, n;
    printf("enter size of array: ");
    scanf("%d", &n);
    int array[n];
    printf("Enter elements of array : \n");
    for(i=0; i<n; i++)
    {
        scanf("%d",&array[i]);
    }
    int largest=array[0];
    for(i=0; i<n; i++)
    {
        if(array[i]>largest)
        {
           largest=array[i];
        }
    }
    int smallest=array[0];
    for(i=0; i<n; i++)
    {
        if(array[i]<smallest)
        {
           smallest=array[i];
        }
    }
    printf("largest element of arrray is= %d\n", largest);
    printf("smallest element of array is= %d", smallest);
    return 0;
}
