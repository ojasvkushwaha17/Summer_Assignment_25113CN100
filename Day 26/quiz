#include <stdio.h>
int main()
{
    int answer, score = 0;
    printf("===== QUIZ APPLICATION =====\n");

    // Question 1
    printf("1. What is the capital of India?\n");
    printf("1. Mumbai\n2. New Delhi\n3. Kolkata\n4. Chennai\n");
