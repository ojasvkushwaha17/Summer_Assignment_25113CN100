#include <stdio.h>
int main()
{
    int mat[25][25], transpose[25][25], row, column, i, j;
    printf("Enter number of rows and columns: \n");
    scanf("%d %d", &row, &column);
    printf("Enter elements of matrix:\n");
    for(i=0; i<row; i++) 
    {
        for(j=0; j<column; j++) 
        {
            scanf("%d", &mat[i][j]);
        }
    }
    for(i=0; i<row; i++) 
    {
        for(j=0; j<column; j++) 
        {
            transpose[j][i]=mat[i][j];
        }
    }
    printf("transpose of matrix: \n");
    for(i=0; i<column; i++)
    {
        for(j=0; j<row; j++)
        {
            printf("%d\t", transpose[i][j]);
        }
        printf("\n");
    }
    return 0;
}
