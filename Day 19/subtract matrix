#include <stdio.h>
int main()
{
    int mat1[25][25], mat2[25][25], row, column, i, j, sub[25][25];
    printf("Enter number of rows and columns: \n");
    scanf("%d %d", &row, &column);
    printf("Enter elements of first matrix:\n");
    for(i=0; i<row; i++) 
    {
        for(j=0; j<column; j++) 
        {
            scanf("%d", &mat1[i][j]);
        }
    }
    printf("Enter elements of second matrix:\n");
    for(i=0; i<row; i++) 
    {
        for(j=0; j<column; j++) 
        {
            scanf("%d", &mat2[i][j]);
        }
    }
    for(i=0; i<row; i++) 
    {
        for(j=0; j<column; j++) 
        {
            sub[i][j]=mat1[i][j]-mat2[i][j];
        }
    }
    printf("subtraction of mat1 and mat2: \n");
    for(i=0; i<row; i++)
    {
        for(j=0; j<column; j++)
        {
            printf("%d\t", sub[i][j]);
        }
        printf("\n");
    }
    return 0;
}
