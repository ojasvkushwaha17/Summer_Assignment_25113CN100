#include <stdio.h>
struct Employee
{
    int empId;
    char name[50];
    int age;
    char domain[50];
};

int main()
{
    int n;
    printf("Enter number of employees: ");
    scanf("%d",&n);
    
    struct Employee e[n];
    for(int i=1; i<=n; i++)
    {
        printf("employee %d\n", i);
        
        printf("enter employee id: ");
        scanf("%d", &e[i].empId);
        
        printf("Enter Name: ");
        scanf("%s",&e[i].name);
        
        printf("Enter age: ");
        scanf("%d",&e[i].age);
        
        printf("Enter domain: ");
        scanf("%s",&e[i].domain);
    }
    
    printf("\n===== EMPLOYEE RECORDS =====\n");
    for(int i=1;i<=n;i++)
    {
        printf("\nemployee id: %d",e[i].empId);
        printf("\nName: %s",e[i].name);
        printf("\nAge: %d",e[i].age);
        printf("\nDomain: %s\n",e[i].domain);
    }
    int searchempId;
    int found = 0;

    printf("\nEnter employee id to search: ");
    scanf("%d",&searchempId);

    for(int i=1;i<=n;i++)
    {
        if(e[i].empId == searchempId)
        {
            printf("\nEmployee Found!");
            printf("\nName: %s",e[i].name);
            printf("\nAge: %d",e[i].age);
            printf("\nDomain: %s",e[i].domain);

            found = 1;
            break;
        }
    }
    if(found == 0)
    {
        printf("Employee not found.\n");
    }
    return 0;
}
