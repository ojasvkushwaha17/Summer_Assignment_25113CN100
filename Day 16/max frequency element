#include<stdio.h>
int main()
{
    int n, i, j, element, freq=0;
    printf("enter size of array: ");
    scanf("%d", &n);
    int array[n];
    printf("enter elements of array: \n");
    for(i=0; i<n; i++)
    {
        scanf("%d", &array[i]);
    }
    for(i=0; i<n; i++)
    {
        int count=0;
        for(j=0; j<n; j++)
        {
            if(array[j]==array[i])
            count++;
        }
        if(count>freq)
        {
            freq=count;
            element=array[i];
        }
    }
    printf("max frequency element: %d\n", element);
    printf("frequency: %d\n", freq);
    return 0;
}
