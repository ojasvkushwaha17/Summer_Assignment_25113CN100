#include <stdio.h>
int main()
{
    int i, j;
    char ch;
    printf("repeated character pattern: \n");
    for(i=1; i<=5; i++)
    {
        int A=65;
        for(j=1; j<=i; j++)
        {
            char ch='A'+i-1;
            printf("%c", ch);
            A++;
        }
        printf("\n");
    }
    return 0;
}
