#include <stdio.h>
int factorial(int num)
{
    if(num==0||num==1)
    {
        return 1;
    }
    else
    {
        return num*factorial(num-1);
    }
}
int main()
{
    int num;
    printf("enter number: ");
    scanf("%d", &num);
    if(num<0)
    {
        printf("factorial not exist.");
    }
    else
    {
        printf("factorial= %d", factorial(num));
    }
    return 0;
}
