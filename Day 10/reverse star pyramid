#include <stdio.h>
int main()
{
    int i, j, k, n;
    printf("number of rows: ");
    scanf("%d", &n);
    printf("star pattern: \n");
    for(i=1; i<=n; i++)
    {
        for(k=9; k>=n-i; k--)
        {
        printf(" ");
        }
        for(j=9; j>=2*i-1; j--)
        {
        printf("*");
        }
        printf("\n");
    }
    return 0;
}
