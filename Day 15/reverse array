#include <stdio.h>
int main()
{
    int i, n, temp;
    printf("enter size of array: ");
    scanf("%d", &n);
    int array[n];
    printf("enter elements of array: \n");
    for(i=0; i<n; i++)
    {
        scanf("%d", &array[i]);
    }
    for(i=0; i<n/2; i++)
    {
        temp=array[i];
        array[i]=array[n-i-1];
        array[n-i-1]=temp;
    }
    printf("reverse array: \n");
    for(i=0; i<n; i++)
    {
        printf("%d\n", array[i]);
    }
    return 0;
}
