#include <stdio.h>
int main()
{
    int i, n, temp;
    printf("enter size of array: ");
    scanf("%d", &n);
    int array[n];
    printf("enter elements of array: \n");
    for(i=0; i<n; i++)
    {
        scanf("%d", &array[i]);
    }
    temp=array[n-1];
    for(i=n-1; i>=0; i--)
    {
        array[i]=array[i-1];
    }
    array[0]=temp;
    printf("left shifted array: \n");
    for(i=0; i<n; i++)
    {
        printf("%d\n", array[i]);
    }
    return 0;
}
