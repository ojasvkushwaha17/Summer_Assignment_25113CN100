#include <stdio.h>
int prime(int num)
{
    int i, c=0;
    for(i=1; i<=num; i++)
    if(num%i==0)
    {
        c++;
    }
    if(c==2)
    {
        printf("number is a prime number.");
    }
    else
    {
        printf("not a prime number.");
    }
}
int main()
{
    int num;
    printf("enter number: ");
    scanf("%d", &num);
    prime(num);
    return 0;
}
