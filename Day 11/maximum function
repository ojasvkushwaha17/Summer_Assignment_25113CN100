#include <stdio.h>
int max(int num1, int num2)
{
    if(num1>num2)
    {
        return num1;
    }
    else
    {
        return num2;
    }
}
int main()
{
    int num1, num2, maximum;
    printf("enter two numbers: ");
    scanf("%d%d", &num1, &num2);
    maximum=max(num1, num2);
    printf("The maximum number is: %d", maximum);
    return 0;
}
