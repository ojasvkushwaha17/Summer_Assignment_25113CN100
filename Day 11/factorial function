#include <stdio.h>
int fact(int num)
{
    int i, fact=1;
    for(i=1; i<=num; i++)
    {
        fact=fact*i;
    }
    return fact;
}
int main()
{
    int num, factorial;
    printf("enter number: ");
    scanf("%d", &num);
    factorial=fact(num);
    printf("factorial is: %d", factorial);
    return 0;
}
